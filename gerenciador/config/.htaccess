# Proteção extra: nega qualquer acesso direto a esta pasta pelo navegador.
# (Os arquivos .php aqui já não são servidos como texto puro pelo Apache,
# mas isso evita acidentes caso alguém salve o .pfx do certificado aqui.)
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
